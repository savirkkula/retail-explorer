table Date
	dataCategory: Time

	measure 'Months in Period' = DISTINCTCOUNT ( 'Date'[Year Month] )
		formatString: 0
		displayFolder: Period

	column Date
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: date

	column 'Date Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: date_key

	column Year
		dataType: int64
		summarizeBy: none
		sourceColumn: year

	column Quarter
		dataType: int64
		summarizeBy: none
		sourceColumn: quarter

	column 'Month Number'
		dataType: int64
		summarizeBy: none
		sourceColumn: month_number

	column 'Month Name'
		dataType: string
		sortByColumn: 'Month Number'
		summarizeBy: none
		sourceColumn: month_name

	column 'Year Month'
		dataType: string
		summarizeBy: none
		sourceColumn: year_month

	column 'Month Start'
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: month_start

	column 'Day Of Week Number'
		dataType: int64
		summarizeBy: none
		sourceColumn: day_of_week_number

	column 'Day Name'
		dataType: string
		sortByColumn: 'Day Of Week Number'
		summarizeBy: none
		sourceColumn: day_name

	column 'Is Weekend'
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_weekend

	column 'Week Number'
		dataType: int64
		summarizeBy: none
		sourceColumn: week_number

	partition Date = entity
		mode: directLake
		source
			entityName: dim_date
			schemaName: dbo
			expressionSource: DatabaseQuery
