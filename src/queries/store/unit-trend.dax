EVALUATE
SUMMARIZECOLUMNS(
    'Date'[Month Start],
    TREATAS({ __UNIT__ }, Unit[Unit Key]),
    FILTER(ALL('Date'[Date]), 'Date'[Date] >= __START__ && 'Date'[Date] <= __END__),
    "UnitSalesPerM2", [Sales per m2],
    "BenchmarkSalesPerM2", [Category Benchmark Density]
)
ORDER BY 'Date'[Month Start]
